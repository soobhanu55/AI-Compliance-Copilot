# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings — set EMBEDDING_PROVIDER to "openai" or "e5"
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# Backend
BACKEND_URL=http://localhost:8000
